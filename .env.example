# Local development only (docker-compose). AWS Lambda never reads .env: its values come
# from SSM / Secrets Manager at deploy time (see serverless.yml and deploy/env/).

# Admin of the local Postgres container (only used to initialize it).
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...

# Service database and user, created on the first start by scripts/database/ (same as AWS).
SERVICE_DB_NAME=turfbook_notifications_dev
SERVICE_DB_USER=notifications_dev_db_user
SERVICE_DB_PASSWORD=...

# The app connects with the service user, never with the admin.
DATABASE_URL=postgresql+psycopg://notifications_dev_db_user:<pass>@db:5432/turfbook_notifications_dev

# Sender of the notice emails (verified in SES) and the DLQ of malformed notices.
# Locally only the Lambda handler uses them; tests replace both.
SES_SENDER=turfbook@gmail.com
DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/local-notices-dlq

# Optional: they have a default in Settings. Uncomment only to use another value.
# API_PREFIX=/api
# SES_REGION=us-east-1
# SES_TIMEOUT_SECONDS=1
# DLQ_TIMEOUT_SECONDS=1
